rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null
        && (
          request.auth.token.get('email_verified', false) == true
          || request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'password'
        );
    }

    function isSafeFaithInFile() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/(jpeg|png|gif|webp|avif|heic|heif)'
          + '|video/(mp4|quicktime|webm|ogg)'
          + '|audio/(mpeg|mp4|x-m4a|aac|wav|x-wav|ogg|webm)'
          + '|application/(pdf|zip)'
        );
    }

    // User-owned media, readable only by its owner.
    //
    // This was `allow read: if isSignedIn()`. A Storage list() is authorised by
    // the read rule at the prefix, so any signed-in member could enumerate
    // faith-in-uploads/<someone-else's-uid>/ and download everything in it —
    // and uids are not secret, publicProfiles hands them to every verified
    // member. Nothing in the app reads from Firebase Storage any more (media
    // goes to Supabase), so scoping this to the owner closes the hole without
    // affecting anything that is running.
    match /faith-in-uploads/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && isSafeFaithInFile();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Legacy path kept read-only so old files do not break.
    match /faith-in-uploads/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
