# =========================================================================
# Vercel Deployment Note
# These environment variables must be configured in Vercel Project Settings -> Environment Variables.
# Do NOT include real secrets in this file.
# =========================================================================

# Database connection string (e.g. from Vercel Postgres, Neon, or Supabase)
DATABASE_URL=

# NextAuth.js Secret - Use `npx auth secret` to generate a random one
AUTH_SECRET=

# Optional: Google OAuth Credentials (for NextAuth)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel Blob (for image/video uploads)
BLOB_READ_WRITE_TOKEN=

# Optional AI feature keys
GEMINI_API_KEY=
